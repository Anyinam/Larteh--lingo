# ---------------------------------------------------------------------------
# Flask Core & Security Configuration
# ---------------------------------------------------------------------------
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=larteh_lingo_super_secret_production_key_change_me
PORT=5000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://larteh_user:larteh_secure_password@localhost:5432/larteh_lingo
# SQLite fallback for quick local testing without PostgreSQL:
# DATABASE_URL=sqlite:///larteh_lingo.db

# ---------------------------------------------------------------------------
# Cloudflare R2 Object Storage (S3-Compatible)
# ---------------------------------------------------------------------------
STORAGE_BACKEND=r2

# Your Cloudflare 32-character Account ID (found in Cloudflare Dashboard -> R2)
R2_ACCOUNT_ID=7dad8b3176a921d1f3706a52e9c9835f

# R2 API Token with Object Read & Write permissions
R2_ACCESS_KEY_ID=1a8196e214b7b2150f23b28d82478a07
R2_SECRET_ACCESS_KEY=f914ba27ed02c29977c2b3d34efb990bec611b1aecb2bd49a1d61d8bd2443987

# R2 Bucket Name
R2_BUCKET_NAME=larteh-lingo-audio

# Public CDN / Custom Domain connected to your R2 bucket (e.g., https://pub-xxx.r2.dev or custom domain)
R2_PUBLIC_DOMAIN=https://pub-1a98431304e6435d8ed38496580e01b7.r2.dev

# Optional Local Storage Fallback (used when STORAGE_BACKEND=local or R2 is unconfigured)
LOCAL_UPLOAD_FOLDER=uploads
